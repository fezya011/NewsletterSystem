{
  "name": "newsletter/system",
  "description": "Multi-website newsletter and web push notification system",
  "type": "library",
  "require": {
    "php": ">=8.4",
    "ext-json": "*",
    "ext-pdo": "*",
    "ext-curl": "*",
    "ext-openssl": "*",
    "ext-mbstring": "*",
    "minishlink/web-push": "^9.0",
    "phpmailer/phpmailer": "^6.9",
    "symfony/css-selector": "^7.0",
    "symfony/dom-crawler": "^7.0"
  },
  "require-dev": {
    "roave/security-advisories": "dev-latest"
  },
  "autoload": {
    "psr-4": {
      "Newsletter\\": "src/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": false
  }
}